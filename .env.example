# Server port
PORT=3000

# Admin passcode for destructive endpoints (reset, delete)
ADMIN_PASSCODE=

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# Target Drive folder (the folder that will hold the per-section subfolders)
# Use a Shared Drive ID (starts with 0A) for service account uploads,
# or a My Drive folder ID (starts with 1A) with OAuth2 user account.
GOOGLE_DRIVE_FOLDER_ID=0ACktHqI8zSSCUk9PVA

# --- Option A (RECOMMENDED): OAuth2 as your own Google account ---
# Get these from Google Cloud Console + OAuth 2.0 Playground.
# Requires: OAuth client (Web application) + authorized redirect URI
#           https://developers.google.com/oauthplayground
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_OAUTH_REDIRECT_URI=https://developers.google.com/oauthplayground

# --- Option B: Service account (only works with a Shared Drive) ---
